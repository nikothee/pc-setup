<background>
  <starttime>
    <year>2023</year>
    <month>09</month>
    <day>01</day>
    <hour>8</hour>
    <minute>00</minute>
    <second>00</second>
  </starttime>
  <!-- This animation will start at 8 AM. -->

  <!-- We start with noon at 8 AM. It will remain up for 10 hours. -->
  <static>
    <duration>36000.0</duration>
    <file>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Noon.avif</file>
  </static>

  <!-- Noon ended and starts to transition to evening at 6 PM. The transition lasts for 2 hours,
  ending at 8 PM. -->
  <transition type="overlay">
    <duration>7200.0</duration>
    <from>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Noon.avif</from>
    <to>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Evening.avif</to>
  </transition>

  <!-- It's 8 PM, we're showing the evening till 6 AM. -->
  <static>
    <duration>36000.0</duration>
    <file>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Evening.avif</file>
  </static>

  <!-- It's 6 AM, and we're starting to transition to noon. Transition completes at 8 AM. -->
  <transition type="overlay">
    <duration>7200.0</duration>
    <from>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Evening.avif</from>
    <to>/usr/share/backgrounds/wow_silithus/Chronicle_4_Silithus_Noon.avif</to>
  </transition>

</background>
